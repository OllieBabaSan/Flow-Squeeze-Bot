DISCORD_WEBHOOK_URL=
DISCORD_ALERT_ROLE_ID=
FLOW_POLL_SECONDS=30
# Minimum 12; production defaults to 24 hours to suppress same-market whipsaws.
FLOW_ALERT_COOLDOWN_HOURS=24
# Bounded Binance OI requests are retried instead of sent as one large burst.
BINANCE_OI_CONCURRENCY=8
BINANCE_OI_RETRIES=2
# Completed breakout research is retained for 90 days before daily pruning.
BREAKOUT_RETENTION_DAYS=90
# Optional: improves liquidation evidence in squeeze follow-ups.
COINMARKETCAP_API_KEY=
# Optional CoinGecko demo key used by token identity verification.
COINGECKO_DEMO_API_KEY=
