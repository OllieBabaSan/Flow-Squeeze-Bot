# Optional paid CryptoPanic integration. Direct publisher feeds work without it.
CRYPTOPANIC_AUTH_TOKEN=
CRYPTOPANIC_API_PLAN=growth
DISCORD_WEBHOOK_URL=
DISCORD_X_ALERT_WEBHOOK_URL=
LUNARCRUSH_API_KEY=
COINMARKETCAP_API_KEY=
X_PRIMARY_ENABLED=false
X_BEARER_TOKEN=
X_SOURCE_TARGET=600
X_SOURCE_REGISTRY=data/x-source-registry.json
X_DISPATCH_DEBOUNCE_MS=200
X_POST_READ_COST_USD=0.005
PROJECT_MONTHLY_BUDGET_USD=50
PROJECT_FIXED_MONTHLY_COST_USD=0
OPENAI_INPUT_COST_PER_M=2
OPENAI_CACHED_INPUT_COST_PER_M=0.2
OPENAI_CACHE_WRITE_COST_PER_M=2.5
OPENAI_OUTPUT_COST_PER_M=12
COINGECKO_API_KEY=
COINGECKO_PRO_API_KEY=
KOL_X_HANDLES=CryptoHayes
DISCORD_ALERT_ROLE_ID=123456789012345678
DISCORD_X_ALERT_ROLE_ID=123456789012345678

# Standalone Flow/Squeeze deployment. Disable unrelated news and shadow research if desired.
FLOW_SQUEEZE_ENABLED=true
# Independent Flow/Squeeze scan cadence. The detector requires observations to
# be at least 20 seconds apart; 30 seconds is the recommended balance.
FLOW_POLL_SECONDS=30
NEWS_ALERTS_ENABLED=true

# Final editorial review. Enable only after OPENAI_API_KEY is configured.
EDITORIAL_GATE_ENABLED=false
OPENAI_API_KEY=
OPENAI_EDITORIAL_MODEL=gpt-5.6-terra
OPENAI_EDITORIAL_REASONING=low
EDITORIAL_SHADOW_MODEL=gpt-5.6-luna
EDITORIAL_SHADOW_SAMPLE_RATE=0.1
EDITORIAL_MIN_CONFIDENCE=0.82

# Hosted dispatcher is off by default. Local radar does not need these.
HOSTED_DISPATCH_ENABLED=false
DISPATCH_SECRET=

# Observation-only early-move detector. It does not post to Discord.
DIRECTIONAL_PRESSURE_ENABLED=true
DIRECTIONAL_PRESSURE_VENUES=Hyperliquid,Kraken
PRESSURE_POLL_SECONDS=30
CMC_DERIVATIVES_CANDIDATE_DAILY_LIMIT=50
