DISCORD_WEBHOOK_URL=
DISCORD_ALERT_ROLE_ID=
FLOW_POLL_SECONDS=30
# Minimum 12; production defaults to 24 hours to suppress same-market whipsaws.
FLOW_ALERT_COOLDOWN_HOURS=24
# Bounded Binance OI requests are retried instead of sent as one large burst.
BINANCE_OI_CONCURRENCY=8
BINANCE_OI_RETRIES=2
# Completed breakout research is retained for 90 days before daily pruning.
BREAKOUT_RETENTION_DAYS=90
# Research admission sampling. Qualified observations are retained in full;
# weaker control cohorts are sampled deterministically to bound storage.
BREAKOUT_ADMISSION_COOLDOWN_MINUTES=60
BREAKOUT_ADMISSION_QUALIFIED_RATE=1
BREAKOUT_ADMISSION_WATCH_RATE=0.1
BREAKOUT_ADMISSION_LOW_QUALITY_RATE=0.05
BREAKOUT_ADMISSION_ACTIVITY_MISSING_RATE=0.05
# Optional: improves liquidation evidence in squeeze follow-ups.
COINMARKETCAP_API_KEY=
# Shadow-only aggregate derivatives context interval and protected credit floor.
CMC_CONTEXT_INTERVAL_MINUTES=15
CMC_MONTHLY_CREDIT_RESERVE=1500
# Research-only fast-move cohort; never publishes Discord alerts or places trades.
FLOW_FAST_MOVE_SHADOW=true
FLOW_FAST_MOVE_MIN_AGE_SECONDS=20
FLOW_FAST_MOVE_MAX_AGE_SECONDS=59
FLOW_FAST_MOVE_MIN_MOVE_PCT=0.5
FLOW_FAST_MOVE_MAX_SPREAD_BPS=15
FLOW_FAST_MOVE_MIN_TURNOVER_USD=500000
FLOW_FAST_MOVE_MIN_OI_GROWTH_PCT=0.3
# Optional CoinGecko demo key used by token identity verification.
COINGECKO_DEMO_API_KEY=
